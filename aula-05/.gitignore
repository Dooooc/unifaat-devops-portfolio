# ── Terraform State — NUNCA commitar ────────────────────────
*.tfstate
*.tfstate.*
*.tfstate.backup

# ── Providers baixados ────────────────────────────────────────
.terraform/

# ── Variáveis sensíveis (contêm senha do banco) ───────────────
terraform.tfvars
*.tfvars.local
secrets.tfvars

# ── Credenciais AWS ───────────────────────────────────────────
aws-creds.sh

# ── Chaves SSH geradas pelo Terraform ─────────────────────────
*.pem
*.key

# ── Planos binários ───────────────────────────────────────────
*.tfplan

# ── Crash logs ───────────────────────────────────────────────
crash.log
crash.*.log

# ── Override files ────────────────────────────────────────────
override.tf
override.tf.json
*_override.tf
*_override.tf.json
