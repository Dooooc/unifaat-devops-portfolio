# ============================================================
# EXEMPLO DE CONFIGURAÇÃO — copie para terraform.tfvars
# e preencha os valores reais (especialmente db_password)
#
# cp terraform.tfvars.example terraform.tfvars
# ============================================================

aws_region   = "us-east-1"
environment  = "development"
student_ra   = "6325238"
student_name = "Yuri"

vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24"]
private_subnet_cidrs = ["10.0.2.0/24", "10.0.4.0/24"]
availability_zones   = ["us-east-1a", "us-east-1b"]

instance_type    = "t2.micro"
api_port         = 3000
ssh_allowed_cidr = "0.0.0.0/0"

db_instance_class    = "db.t3.micro"
db_allocated_storage = 20
db_engine_version    = "15"
db_name              = "technovadb"
db_username          = "technova_admin"
db_password          = "SUBSTITUA_POR_SENHA_SEGURA"   # mínimo 8 caracteres
db_port              = 5432

state_bucket_name    = "technova-tfstate-6325238"
state_dynamodb_table = "technova-tfstate-lock"
